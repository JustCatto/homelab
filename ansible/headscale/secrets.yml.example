---
# Public DNS hostname for this Headscale server. Point it at this VM before deploying.
headscale_domain: headscale.example.com
# MagicDNS tailnet domain; MUST differ from headscale_domain.
tailnet_domain: tailscale.cattoindustries.com

# Full email-style Headscale user name, e.g. user@example.com.
headscale_admin_user: REPLACE_WITH_ADMIN_EMAIL
