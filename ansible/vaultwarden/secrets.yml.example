---
# Copy to secrets.yml (ignored by Git). Generate a hash with `docker run --rm -it vaultwarden/server:1.37.4 /vaultwarden hash`.
# Choose a name in a publicly authoritative Cloudflare zone; private DNS may resolve it to the VM's Tailscale IPv4.
vaultwarden_domain: bitwarden.cattoindustries.com
# Existing Headscale control server URL and an unexpired pre-authentication key.
headscale_url: https://headscale.example.com
headscale_auth_key: 'REPLACE_WITH_HEADSCALE_PREAUTH_KEY'
# Cloudflare API token with Zone:Read and DNS:Edit for vaultwarden_domain's public zone.
cloudflare_dns_api_token: REPLACE_WITH_CLOUDFLARE_API_TOKEN
vaultwarden_admin_token: '$argon2id$REPLACE_WITH_GENERATED_VAULTWARDEN_HASH'
